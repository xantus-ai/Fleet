# --- Postgres ---
# Works as-is with the bundled docker-compose.yml (`docker compose up -d`)
# or a local Postgres install (Homebrew, etc.).
DATABASE_URL=postgres://postgres@localhost:5432/fleet

# --- HTTP server ---
PORT=8787

# --- Linear ---
# Webhook signing secret from Linear → Settings → API → Webhooks
LINEAR_WEBHOOK_SECRET=
# Personal API key (or OAuth token) used to post comments back
LINEAR_API_KEY=
# Only issues carrying this label will trigger an agent run
LINEAR_TRIGGER_LABEL=agent-ready
# Workflow state names the fleet transitions issues to. Matched
# case-insensitively against the issue's team workflow states. Leave
# empty to disable that transition. Set to "In Progress" when the
# worker picks up the task, "In Review" once the PR is opened.
LINEAR_STATE_IN_PROGRESS=In Progress
LINEAR_STATE_IN_REVIEW=In Review

# --- GitHub ---
# Default repo the fleet works on. Format: owner/name
GITHUB_DEFAULT_REPO=
# Absolute path to the local checkout of GITHUB_DEFAULT_REPO. Worktrees
# go in a sibling dir: <dirname(REPO_PATH)>/<basename(REPO_PATH)>-worktrees/<task-id>
REPO_PATH=
# Default branch to base PRs against
DEFAULT_BRANCH=main

# --- Agent ---
# Model the fleet uses by default
AGENT_MODEL=claude-sonnet-4-6
# Maximum agent turns before forced stop
AGENT_MAX_TURNS=80
# Hard USD cap per task (in addition to token + wallclock budgets)
AGENT_MAX_USD=5

# --- Bot identity (per-worktree) ---
# When set, every commit the agent makes is attributed to this name +
# email instead of your machine's default git identity. Applied as
# per-worktree config so it does NOT affect the cloud repo's main
# checkout or any other repo on this machine — only the ephemeral
# worktrees the fleet creates. Leave both empty to keep the operator's
# normal identity on agent commits.
#
# Use the bot's GitHub noreply address so commits link to the bot's
# profile and the bot's real email never lands in git history. Find it
# at github.com/settings/emails (signed in as the bot).
BOT_GIT_NAME=
BOT_GIT_EMAIL=

# --- GitHub auth used by the worker (subprocesses) ---
# Classic PAT for the bot account. The worker process loads .env, so
# every `git push` and `gh pr create` it spawns picks this up via the
# `gh` credential helper. Your manual terminals don't load .env, so
# they keep using whichever account `gh auth` has active (= you). This
# is how one machine runs the fleet bot AND your personal work.
GH_TOKEN=

# --- Anthropic / Claude Agent SDK ---
ANTHROPIC_API_KEY=

# --- Workers ---
# How many tasks can run on this machine concurrently
WORKER_CONCURRENCY=2
WORKER_ID=local-1
# Per-task budgets
TASK_TOKEN_BUDGET=2000000
TASK_WALLCLOCK_SECONDS=1800
# Hard daily USD cap across the entire fleet. When the running 24h total
# exceeds this, workers stop claiming new tasks (in-flight ones finish).
# Set to 0 to disable.
FLEET_DAILY_USD_CAP=50
# CoW-clone node_modules from the source repo into each fresh worktree
# (APFS clonefile on macOS, reflink on Linux). Agents can run typecheck
# and tests immediately without a cold `npm install` — saves ~5 turns
# and 30-60s per task. Safe: the agent's installs don't propagate back
# to the main checkout. Set to 0 to disable.
WORKER_SHARE_NODE_MODULES=1

# --- Webhook security ---
# Set to 1 only for local development without a Linear secret. Production
# should always set LINEAR_WEBHOOK_SECRET; the receiver refuses to start
# without one unless this flag is on.
FLEET_ALLOW_UNSIGNED_WEBHOOKS=0
