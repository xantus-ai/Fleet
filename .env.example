# --- Postgres ---
DATABASE_URL=postgres://postgres@localhost:5432/fleet

# --- HTTP server ---
PORT=8787

# --- Linear ---
# Webhook signing secret from Linear → Settings → API → Webhooks
LINEAR_WEBHOOK_SECRET=
# Personal API key (or OAuth token) used to post comments back
LINEAR_API_KEY=
# Only issues carrying this label will trigger an agent run
LINEAR_TRIGGER_LABEL=agent-ready

# --- GitHub ---
# Default repo the fleet works on. Format: owner/name
GITHUB_DEFAULT_REPO=
# Absolute path to the local checkout of GITHUB_DEFAULT_REPO. Worktrees
# go in a sibling dir: <dirname(REPO_PATH)>/<basename(REPO_PATH)>-worktrees/<task-id>
REPO_PATH=
# Default branch to base PRs against
DEFAULT_BRANCH=main

# --- Agent ---
# Model the fleet uses by default
AGENT_MODEL=claude-sonnet-4-6
# Maximum agent turns before forced stop
AGENT_MAX_TURNS=80
# Hard USD cap per task (in addition to token + wallclock budgets)
AGENT_MAX_USD=5

# --- Anthropic / Claude Agent SDK ---
ANTHROPIC_API_KEY=

# --- Workers ---
# How many tasks can run on this machine concurrently
WORKER_CONCURRENCY=2
WORKER_ID=local-1
# Per-task budgets
TASK_TOKEN_BUDGET=2000000
TASK_WALLCLOCK_SECONDS=1800
# Hard daily USD cap across the entire fleet. When the running 24h total
# exceeds this, workers stop claiming new tasks (in-flight ones finish).
# Set to 0 to disable.
FLEET_DAILY_USD_CAP=50

# --- Webhook security ---
# Set to 1 only for local development without a Linear secret. Production
# should always set LINEAR_WEBHOOK_SECRET; the receiver refuses to start
# without one unless this flag is on.
FLEET_ALLOW_UNSIGNED_WEBHOOKS=0
